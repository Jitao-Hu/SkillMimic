<?xml version="1.0"?>
<!--
  Static basketball hoop asset used for visualization in the
  SkillMimicMultiPlayer inference scene. Rim center is at local (0, 0.225, 3.05)
  relative to the link origin; place the actor so the pole base sits on the
  ground. Loaded with fix_base_link=True and disable_gravity=True.
-->
<robot name="basket">
  <link name="basket">

    <!-- Pole: 3.05m tall thin cylinder, planted behind the backboard. -->
    <visual>
      <origin xyz="0 -0.35 1.525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="3.05"/>
      </geometry>
      <material name="pole_mat">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.35 1.525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="3.05"/>
      </geometry>
    </collision>

    <!-- Backboard: 1.8m wide x 1.05m tall, 0.05m thick.
         Bottom edge at z=2.90m, top at z=3.95m, rim meets it 0.3m above bottom. -->
    <visual>
      <origin xyz="0 -0.15 3.425" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 0.05 1.05"/>
      </geometry>
      <material name="backboard_mat">
        <color rgba="0.95 0.95 0.95 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.15 3.425" rpy="0 0 0"/>
      <geometry>
        <box size="1.8 0.05 1.05"/>
      </geometry>
    </collision>

    <!-- Rim: 12 small boxes arranged in a ring of radius 0.225m, centered at
         (0, 0.225, 3.05). Each segment is a 0.12 x 0.03 x 0.03 box rotated
         about Z to approximate a torus.  Segment angle = 30 deg. -->
    <visual>
      <origin xyz="0.2250 0.2250 3.05" rpy="0 0 0"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"><color rgba="0.9 0.35 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.2250 0.2250 3.05" rpy="0 0 0"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.1949 0.3375 3.05" rpy="0 0 0.5236"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.1949 0.3375 3.05" rpy="0 0 0.5236"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.1125 0.4199 3.05" rpy="0 0 1.0472"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.1125 0.4199 3.05" rpy="0 0 1.0472"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.0 0.4500 3.05" rpy="0 0 1.5708"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.4500 3.05" rpy="0 0 1.5708"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.1125 0.4199 3.05" rpy="0 0 2.0944"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.1125 0.4199 3.05" rpy="0 0 2.0944"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.1949 0.3375 3.05" rpy="0 0 2.6180"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.1949 0.3375 3.05" rpy="0 0 2.6180"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.2250 0.2250 3.05" rpy="0 0 3.1416"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.2250 0.2250 3.05" rpy="0 0 3.1416"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.1949 0.1125 3.05" rpy="0 0 3.6652"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.1949 0.1125 3.05" rpy="0 0 3.6652"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.1125 0.0301 3.05" rpy="0 0 4.1888"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.1125 0.0301 3.05" rpy="0 0 4.1888"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.0 0.0 3.05" rpy="0 0 4.7124"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 3.05" rpy="0 0 4.7124"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.1125 0.0301 3.05" rpy="0 0 5.2360"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.1125 0.0301 3.05" rpy="0 0 5.2360"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.1949 0.1125 3.05" rpy="0 0 5.7596"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
      <material name="rim_mat"/>
    </visual>
    <collision>
      <origin xyz="0.1949 0.1125 3.05" rpy="0 0 5.7596"/>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 1.525" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>
</robot>
